{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CleanPaste",
  "version": "0.1.0",
  "identifier": "com.coralgarden52.cleanpaste",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CleanPaste",
        "width": 900,
        "height": 620,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "publisher": "CoralGarden52",
    "copyright": "Copyright (c) 2026 CoralGarden52",
    "shortDescription": "Offline local text processing tool",
    "longDescription": "CleanPaste is a lightweight Windows desktop application for local plain-text conversion, whitespace removal, Unicode-aware statistics, and literal text replacement.",
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": ["English"]
      }
    }
  }
}
